# ─── ODATANO Plugin Configuration ────────────────────────────────────────
# These are read by @odatano/core when running in plugin or standalone mode.
# Plugin-mode config in package.json (cds.requires.odatano-core) takes
# precedence; env vars are the standalone-mode fallback.

# Network: mainnet | preprod | preview
NETWORK=preview

# Backend providers (comma-separated). Priority order matters.
# Options: blockfrost, koios, ogmios
BACKENDS=koios

# Transaction builders (comma-separated). Buildooor recommended (CSL has open Plutus V3 bug).
TX_BUILDERS=buildooor

# Blockfrost API key (preview_*, preprod_*, mainnet_*).
# Get a free key at https://blockfrost.io
BLOCKFROST_API_KEY=preview_YOUR_KEY_HERE

# Optional: Koios API key (only needed for high request volume)
KOIOS_API_KEY=

# Optional: Ogmios websocket URL (only if BACKENDS includes ogmios)
OGMIOS_URL=ws://localhost:1337

# Optional: tuning (defaults shown)
# PRIMARY_TIMEOUT_MS=30000
# FALLBACK_TIMEOUT_MS=60000
# INDEX_TTL_MS=3600000
