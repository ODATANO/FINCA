<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog id="orgDialog"
          title="{= ${dialog>/mode} === 'edit' ? 'Edit Organisation' : 'Add Organisation' }"
          draggable="true"
          contentWidth="500px">
    <content>
      <form:SimpleForm editable="true" layout="ResponsiveGridLayout"
                       labelSpanXL="4" labelSpanL="4" labelSpanM="4"
                       emptySpanXL="0" emptySpanL="0" emptySpanM="0"
                       columnsXL="1" columnsL="1" columnsM="1">
        <Label text="Name" required="true"/>
        <Input value="{name}" placeholder="Company Name GmbH"/>

        <Label text="Currency (ISO 4217)"/>
        <Input value="{currencyCode}" maxLength="3"/>

        <Label text="Country (ISO 3166)"/>
        <Input value="{countryCode}" maxLength="2"/>

        <Label text="Tax ID"/>
        <Input value="{taxIdNumber}" placeholder="DE123456789"/>

        <Label text="Wallet Address (bech32)"/>
        <Input value="{walletAddress}" placeholder="addr_test1q..." width="100%"
               editable="{= ${dialog>/mode} === 'create' }"/>
      </form:SimpleForm>
    </content>
    <beginButton>
      <Button text="{= ${dialog>/mode} === 'edit' ? 'Save' : 'Create' }"
              type="Emphasized" press=".onOrgConfirm"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onOrgCancel"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
