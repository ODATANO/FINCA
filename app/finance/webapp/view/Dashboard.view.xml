<mvc:View xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  controllerName="finca.controller.Dashboard">

  <Page id="dashboardPage" title="Dashboard" showNavButton="false">
    <content>

      <!-- KPI Tiles (pure sap.m) -->
      <HBox wrap="Wrap" class="sapUiSmallMargin" alignItems="Stretch">
        <Panel class="sapUiTinyMarginEnd sapUiTinyMarginBottom" width="200px">
          <VBox class="sapUiSmallMargin" alignItems="Start">
            <Text text="Transactions" class="sapUiTinyMarginBottom"/>
            <ObjectNumber number="{app>/stats/transactionCount}" unit="total" emphasized="true" state="Information"/>
          </VBox>
        </Panel>

        <Panel class="sapUiTinyMarginEnd sapUiTinyMarginBottom" width="200px">
          <VBox class="sapUiSmallMargin" alignItems="Start">
            <Text text="Reports" class="sapUiTinyMarginBottom"/>
            <ObjectNumber number="{app>/stats/reportCount}" unit="total" emphasized="true" state="Information"/>
          </VBox>
        </Panel>

        <Panel class="sapUiTinyMarginEnd sapUiTinyMarginBottom" width="200px">
          <VBox class="sapUiSmallMargin" alignItems="Start">
            <Text text="On-Chain Confirmed" class="sapUiTinyMarginBottom"/>
            <ObjectNumber number="{app>/stats/confirmedCount}" unit="anchors" emphasized="true" state="Success"/>
          </VBox>
        </Panel>

        <Panel class="sapUiTinyMarginEnd sapUiTinyMarginBottom" width="200px">
          <VBox class="sapUiSmallMargin" alignItems="Start">
            <Text text="Pending" class="sapUiTinyMarginBottom"/>
            <ObjectNumber number="{app>/stats/pendingCount}" unit="anchors" emphasized="true"
              state="{= ${app>/stats/pendingCount} > 0 ? 'Warning' : 'Success'}"/>
          </VBox>
        </Panel>

        <Panel class="sapUiTinyMarginEnd sapUiTinyMarginBottom" width="200px">
          <VBox class="sapUiSmallMargin" alignItems="Start">
            <Text text="Periods" class="sapUiTinyMarginBottom"/>
            <ObjectNumber number="{app>/stats/periodCount}" unit="defined" emphasized="true"/>
          </VBox>
        </Panel>
      </HBox>

      <!-- Recent Transactions -->
      <Panel headerText="Recent Transactions" class="sapUiSmallMargin" expandable="false">
        <Table id="recentTxTable"
               items="{path: '/Transactions', parameters: {$orderby: 'createdAt desc', $expand: 'org'}}"
               growing="true" growingThreshold="10">
          <columns>
            <Column><Text text="Number"/></Column>
            <Column><Text text="Date"/></Column>
            <Column><Text text="Type"/></Column>
            <Column><Text text="Organisation"/></Column>
            <Column><Text text="Status"/></Column>
            <Column><Text text="Batch"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onNavTransactions">
              <Text text="{transactionNumber}"/>
              <Text text="{date}"/>
              <Text text="{type}"/>
              <Text text="{org/name}"/>
              <ObjectStatus text="{status}"
                state="{= ${status} === 'CONFIRMED' ? 'Success' : ${status} === 'PUBLISHED' ? 'Warning' : ${status} === 'VALIDATED' ? 'Information' : 'None'}"/>
              <Text text="{batchId}"/>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

      <!-- Recent Anchors -->
      <Panel headerText="Recent On-Chain Anchors" class="sapUiSmallMargin" expandable="false">
        <Table id="recentAnchorTable"
               items="{path: '/OnChainAnchors', parameters: {$orderby: 'createdAt desc'}}"
               growing="true" growingThreshold="5">
          <columns>
            <Column width="15%"><Text text="Status"/></Column>
            <Column><Text text="TX Hash"/></Column>
            <Column width="15%"><Text text="Submitted"/></Column>
            <Column width="15%"><Text text="Confirmed"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <ObjectStatus text="{status}"
                state="{= ${status} === 'CONFIRMED' ? 'Success' : ${status} === 'SUBMITTED' ? 'Warning' : ${status} === 'FAILED' ? 'Error' : 'None'}"/>
              <Text text="{= ${txHash} ? ${txHash}.substring(0, 24) + '...' : '—'}" class="fincaMono"/>
              <Text text="{submittedAt}"/>
              <Text text="{= ${confirmedAt} || '—'}"/>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

    </content>
  </Page>
</mvc:View>
